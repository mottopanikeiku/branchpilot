{
  "inbound_api_key_envs": [
    "BRANCHPILOT_GATEWAY_KEY"
  ],
  "request_timeout_s": 90,
  "queue_timeout_s": 2,
  "max_concurrent_sessions": 32,
  "upstreams": {
    "local": {
      "base_url": "http://127.0.0.1:8001/v1",
      "api_key_env": "BRANCHPILOT_UPSTREAM_KEY",
      "connect_timeout_s": 2,
      "read_timeout_s": 60,
      "write_timeout_s": 10,
      "pool_timeout_s": 2,
      "max_connections": 32,
      "fixed_extra_body": {}
    }
  },
  "models": {
    "math-local": {
      "upstream": "local",
      "upstream_model": "Qwen/Qwen2.5-1.5B-Instruct",
      "plan_path": "gateway-plan.json",
      "extractor": "numeric-strict",
      "max_samples": 8,
      "max_completion_tokens": 512,
      "options": {
        "temperature": 0.7,
        "top_p": 0.95,
        "logprobs": true
      },
      "allow_client_overrides": false,
      "allowed_strategies": []
    }
  }
}
